{
  "name": "calcink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:baseline": "node scripts/testing/run-track.mjs baseline",
    "test:ml": "node scripts/testing/run-track.mjs ml",
    "test:product": "node scripts/testing/run-track.mjs product",
    "release:check": "node scripts/testing/run-track.mjs release"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/node": "22.18.0",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.4",
    "vitest": "3.2.4",
    "fake-indexeddb": "6.2.2"
  }
}
